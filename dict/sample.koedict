# sample.koedict — a sample KOE-IR lexicon (v0.1 draft)
# license: CC BY 4.0
# author: yomiscript contributors
# Note: the readings and accents are illustrative examples and have not been verified.

@lexicon {
  # English abbreviations
  SAP = エスエーピー;
  SIP = シップ [context: 通信, VoIP, 電話];
  SIP = エスアイピー [context: 投資, 積立];

  # Homographs (context conditions + default)
  市 = イチ [context: 朝市, 魚, 市場];
  市 = シ [default];

  # Accent
  箸 = ハ'シ;
  橋 = ハシ';
  端 = ハシ [accent: 0]
}

@lexicon(dialect: kansai) {
  橋 = ハ'シ
}
