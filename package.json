{
  "name": "yomiscript-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write . && ruff format",
    "format:check": "prettier --check . && ruff format --check",
    "lint": "yarn -s build:packages && eslint . && ruff check",
    "release": "sh tools/publish.sh",
    "test": "vitest run",
    "build:packages": "tsc -b packages/core packages/kokoro packages/supertonic packages/ja-accent packages/cli packages/mcp",
    "build": "yarn -s build:packages && yarn workspace @yomiscript/gui-chat-plugin build",
    "typecheck": "yarn -s build:packages && tsc -b packages/core/test packages/supertonic/test packages/ja-accent/test packages/cli/test packages/mcp/test packages/supertonic/tools && yarn workspace @yomiscript/gui-chat-plugin typecheck && tsc -p demo/ys_web/web && tsc -p test"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
