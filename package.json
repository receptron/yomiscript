{
  "name": "yomiscript-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "prettier --write . && ruff format",
    "format:check": "prettier --check . && ruff format --check",
    "lint": "eslint . --cache && ruff check",
    "test": "vitest run",
    "build": "tsc -b packages/core packages/kokoro packages/supertonic packages/cli packages/mcp && yarn workspace @yomiscript/gui-chat-plugin build",
    "typecheck": "tsc -b packages/core packages/kokoro packages/supertonic packages/cli packages/mcp"
  },
  "dependencies": {
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "playwright": "1.48",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "@types/node": "^24.0.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
