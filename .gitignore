__pycache__/
.DS_Store

# JS tooling (root package.json)
node_modules/
.eslintcache

# eval/browser_tts listening audio (regenerated by the audio_* scripts)
eval/browser_tts/audio/
# eval/audio8 blind test audio (blind.mjs)
eval/audio8/audio/

# built TypeScript packages (yarn build)
packages/*/dist/
*.tsbuildinfo

# personal-name data with unconfirmed redistribution terms: kept outside the repository (dict/names/README.md)
dict/names/surnames_top200.csv
dict/names/given_names_by_generation.csv
dict/names/surnames.koedict
dict/names/given_names.koedict

# the Rust build of packages/ja-accent/wasm (its output, wasm/pkg, is kept)
packages/ja-accent/wasm/target/

# copied in by tools/prepack.mjs when a package is packed
packages/*/LICENSE
eval/browser_tts/trials/accent_marks/audio/

# API keys for the eval scripts (eval/prosody_ref/refs.mjs): never committed
.env

# eval/prosody_ref audio (regenerated: refs.mjs, ours.mjs) and the per-mora scores of every render (score.py tool;
# the README has the numbers)
eval/prosody_ref/audio/
eval/prosody_ref/results/tool.json
eval/prosody_ref/results/*.pkl
