{
  "name": "@yomiscript/gui-chat-plugin",
  "version": "0.1.0",
  "description": "gui-chat-protocol plugin: the LLM speaks (YomiScript) while the original text is shown",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/yomiscript.git",
    "directory": "packages/gui-chat-plugin"
  },
  "homepage": "https://github.com/receptron/yomiscript/tree/main/packages/gui-chat-plugin#readme",
  "bugs": {
    "url": "https://github.com/receptron/yomiscript/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "yarn --cwd ../.. build && node ../../tools/prepack.mjs"
  },
  "dependencies": {
    "@yomiscript/core": "^0.1.0",
    "@yomiscript/ja-accent": "^0.1.0",
    "@yomiscript/kokoro": "^0.1.0",
    "onnxruntime-web": "1.22.0"
  },
  "peerDependencies": {
    "gui-chat-protocol": "^2.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "gui-chat-protocol": "^2.3.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.14"
  }
}
