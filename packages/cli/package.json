{
  "name": "yomiscript",
  "version": "0.1.0",
  "description": "YomiScript CLI: speak YomiScript with a Katarite",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/yomiscript.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/receptron/yomiscript/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/receptron/yomiscript/issues"
  },
  "type": "module",
  "bin": {
    "yomiscript": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn --cwd ../.. build && node ../../tools/prepack.mjs"
  },
  "dependencies": {
    "@yomiscript/core": "^0.1.0",
    "@yomiscript/kokoro": "^0.1.0",
    "@yomiscript/supertonic": "^0.1.0",
    "onnxruntime-node": "1.22.0"
  }
}
