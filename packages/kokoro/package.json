{
  "name": "@yomiscript/kokoro",
  "version": "0.1.0",
  "description": "Kokoro-82M Katarite: YomiScript -> Kokoro input -> audio (onnxruntime-web w16 in the browser, onnxruntime-node fp32 in Node)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/yomiscript.git",
    "directory": "packages/kokoro"
  },
  "homepage": "https://github.com/receptron/yomiscript/tree/main/packages/kokoro#readme",
  "bugs": {
    "url": "https://github.com/receptron/yomiscript/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn --cwd ../.. build && node ../../tools/prepack.mjs"
  },
  "dependencies": {
    "@yomiscript/core": "^0.1.0",
    "onnxruntime-common": "1.22.0"
  },
  "peerDependencies": {
    "onnxruntime-node": "1.22.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "onnxruntime-node": "1.22.0"
  }
}
