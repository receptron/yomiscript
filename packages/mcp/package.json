{
  "name": "@yomiscript/mcp",
  "version": "0.1.0",
  "description": "MCP server: a speak tool that takes YomiScript written by the calling LLM",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/yomiscript.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/receptron/yomiscript/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/receptron/yomiscript/issues"
  },
  "type": "module",
  "bin": {
    "yomiscript-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn --cwd ../.. build && node ../../tools/prepack.mjs"
  },
  "dependencies": {
    "@yomiscript/core": "^0.1.0",
    "@yomiscript/kokoro": "^0.1.0",
    "@yomiscript/supertonic": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7",
    "yomiscript": "^0.1.0"
  }
}
